SECRET_KEY=

TELEGRAM_BOT_TOKEN=
DEBUG=1
ADMINS=[111, 222, 333] # telegram_id админов

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

REDIS_URL=

# режим интеграций: sim (симуляция БАРС/ОСЭП) | file | real (после подключения клиентов)
INTEGRATION_MODE=sim

# период тика планировщика, сек
SCHEDULER_TICK_SECONDS=10

# частые проверки в тестовых режимах (sim/file), сек
SIM_POLL_INTERVAL_SECONDS=10

# напоминания о проставлении пар в тестовых режимах: каждые N секунд (0 = выкл)
# в real — раз в день в 18:00 GMT+3
SIM_REMINDER_INTERVAL=0

# шарики статуса сервиса: обычный эмодзи либо числовой id премиум-эмодзи
# (переливающийся; нужен Telegram Premium у получателя)
STATUS_EMOJI_UP=🟢
STATUS_EMOJI_DOWN=🔴

# начальные глобальные настройки: импортируются в БД при первом запуске
# (пустая таблица global_settings); дальше меняются из админки (/admin)
POLL_INTERVAL_SECONDS=180
MAX_POLL_INTERVAL_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=30
ERROR_TIMEOUT_SECONDS=300
AUTO_SCALE_ENABLED=1
# уведомления админам: сервис поднялся/упал
NOTIFY_SERVICE_STATUS=0
# уведомления админам: новые пользователи
NOTIFY_NEW_USERS=1